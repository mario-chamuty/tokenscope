{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenScope",
  "version": "1.4.0",
  "identifier": "com.versiontwo.tokscope",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TokenScope",
        "width": 1320,
        "height": 920,
        "center": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Version Two s.r.o.",
    "copyright": "Copyright (c) 2026 Version Two s.r.o.",
    "homepage": "https://www.versiontwo.sk",
    "shortDescription": "AI Coding Token Usage Dashboard",
    "longDescription": "TokenScope monitors and visualizes token usage from AI coding assistants. Track sessions, costs, and usage patterns across projects with real-time dashboards and detailed reports.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "languages": ["English"],
        "compression": "lzma"
      }
    }
  }
}
